% 3-Coloring
%
% Generic 3-coloring infrastructure. The color domain and distinctness
% relation are defined here; graph topology is expressed directly in the
% query goal as neq constraints on adjacent vertices.

% === Colors ===
color(r).
color(g).
color(b).

% Pairs of distinct colors
neq(r, g).  neq(g, r).
neq(r, b).  neq(b, r).
neq(g, b).  neq(b, g).

edge(X, Y) :- neq(X, Y).

eq(X,X).

% Example: 3-color a triangle (vertices a, b, c — all mutually adjacent):
%   atlas horizon 3coloring/db.chc --goal "color(CA), color(CB), color(CC), neq(CA, CB), neq(CB, CC), neq(CA, CC)"
% Expected solutions: the 6 permutations of {r, g, b} across the three vertices.
%
% Example: 3-color a path a -- b -- c (only adjacent pairs constrained):
%   atlas horizon 3coloring/db.chc --goal "color(CA), color(CB), color(CC), neq(CA, CB), neq(CB, CC)"
% Expected solutions: 12 (each endpoint has 3 choices, middle is constrained by both).
%
% Origami Sonobe graphs (from YMONGUCHI/Origami-Sonobe-Graph-Coloring):
%    3-node   ( 3 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe3.goal)"
%   12-node  (24 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe12.goal)"
%   30-node  (60 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe30.goal)"
%   36-node  (72 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe36.goal)"
%   48-node  (96 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe48.goal)"
%   54-node (108 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe54.goal)"
%   90-node (180 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe90.goal)"
%  108-node (216 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe108.goal)"
%  144-node (288 edges):  atlas horizon 3coloring/db.chc --goal "$(cat 3coloring/sonobe144.goal)"
